# Generate credentials with scripts/init-deployment.sh. Never commit .env.
# PUBLIC_URL may use http://; plaintext HTTP is unsafe on untrusted networks.
PUBLIC_URL=https://sms.example.com
# Docker host port; the container listens on 8080.
PORT=18473
# Keep loopback for a local HTTPS proxy; use 0.0.0.0 only for direct external access.
BIND_ADDRESS=127.0.0.1
# Hub image version tag; defaults to latest or set to a specific version (e.g. 0.1.0-alpha.5).
HONGSHU_VERSION=latest
HONGSHU_PASSWORD=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
BACKUP_INTERVAL=86400
