# Generate credentials with scripts/init-deployment.sh. Never commit .env.
# PUBLIC_URL may use http://; plaintext HTTP is unsafe on untrusted networks.
# PUBLIC_URL defaults to http://127.0.0.1:${PORT} if unset. Set to exact origin for HTTPS/reverse proxy.
PUBLIC_URL=http://127.0.0.1:18473
# Docker host port; the container listens on 8080.
PORT=18473
# Keep loopback for a local HTTPS proxy; use 0.0.0.0 only for direct external access.
BIND_ADDRESS=127.0.0.1
# Select a published immutable version explicitly; alpha releases do not publish latest.
HONGSHU_VERSION=0.2.0-alpha.23
# Only exact trusted reverse-proxy peer prefixes; leave empty for direct access.
TRUSTED_PROXY_CIDRS=
HONGSHU_PASSWORD=
# Bundled MySQL only. Leave unused when using compose.external.yml.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# bundled (default) or external. Used by scripts/init-deployment.sh.
HONGSHU_DB_MODE=bundled
# External/shared MySQL. Takes precedence over MYSQL_DSN. Use compose.external.yml.
# Example (URL-encode the password; quote the whole value):
# HONGSHU_DATABASE_URL='mysql://hongshu:change-me@mysql.example:3306/hongshu?tls=true&timeout=10s&readTimeout=60s&writeTimeout=60s'
HONGSHU_DATABASE_URL=
# Connection pool and startup limits. Empty means the built-in default.
HONGSHU_DB_MAX_OPEN=
HONGSHU_DB_MAX_IDLE=
HONGSHU_DB_CONN_MAX_LIFETIME=
HONGSHU_DB_CONN_MAX_IDLE_TIME=
HONGSHU_DB_STARTUP_TIMEOUT=
# auto: apply migrations; check: require a current schema; off: skip migration handling.
HONGSHU_MIGRATE=auto
HONGSHU_MIGRATION_LOCK_TIMEOUT=
# Optional private CA / certificate name for external MySQL TLS (mount the file too).
HONGSHU_DB_TLS_CA=
HONGSHU_DB_TLS_SERVER_NAME=
# Optional Redis cache/pub-sub. Never required for correctness.
# HONGSHU_REDIS_URL=redis://:password@redis.example:6379/0
HONGSHU_REDIS_URL=
HONGSHU_REDIS_PREFIX=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
BACKUP_INTERVAL=86400
# Optional: base64-encoded 32 random bytes, required to save an AI API key.
# Preserve with backups. AI stays disabled until explicitly enabled in Web settings.
HONGSHU_AI_SECRET=
# Exact hostnames allowed for private/local AI endpoints (also permits HTTP).
HONGSHU_AI_ALLOWED_HOSTS=
